{
  "expo": {
    "name": "NIVARA",
    "slug": "nivara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nivara",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NIVARA needs your location to share it with emergency contacts when SOS is triggered.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NIVARA needs your location to share it with emergency contacts during an emergency.",
        "NSMicrophoneUsageDescription": "NIVARA uses the microphone for voice trigger detection.",
        "NSMotionUsageDescription": "NIVARA uses motion sensors to detect shaking for SOS activation.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition."
      }
    },
    "android": {
      "package": "com.nivara.safety",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "SEND_SMS",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "VIBRATE",
        "HIGH_SAMPLING_RATE_SENSORS",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "buildProperties": {
        "newArchEnabled": true
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/direct-sms-plugin",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NIVARA needs background location access to keep you protected even when the app is minimized.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E91E8C",
          "defaultChannel": "nivara-protection-channel"
        }
      ],
      "./plugins/native-background-service",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "navyapriya",
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "1fd60205-30a5-4d99-ad9b-c2b5ce7fdd39"
      }
    }
  }
}